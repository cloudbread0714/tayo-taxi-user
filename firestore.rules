rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // passengerId is stored as the user's email in this app.
    function isPassenger(data) {
      return signedIn()
        && data.passengerId is string
        && (
          data.passengerId == request.auth.uid
          || data.passengerId == request.auth.token.email
        );
    }

    function isAssignedDriver(data) {
      return signedIn()
        && 'driverId' in data
        && data.driverId is string
        && data.driverId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isSelf(userId);

      match /{document=**} {
        allow read, write: if isSelf(userId);
      }
    }

    match /ride_requests/{requestId} {
      allow create: if signedIn()
        && isPassenger(request.resource.data)
        && request.resource.data.status == 'pending';

      allow get: if isPassenger(resource.data)
        || isAssignedDriver(resource.data)
        || (signedIn() && resource.data.status == 'pending');

      allow list: if signedIn() && resource.data.status == 'pending';

      allow update: if isPassenger(resource.data)
        || isAssignedDriver(resource.data)
        || (
          signedIn()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['pending', 'accepted']
        );

      allow delete: if isPassenger(resource.data);
    }
  }
}
